PORT=3000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# SKIP_SEED=true -> aplikasi start KOSONG (gak ada auto-seed dummy data).
# Cocok buat production/publish, biar user baru mulai dari nol.
# Tombol "Reset Seed Data" di UI tetap berfungsi kapan aja, terlepas dari
# setting ini, buat user yang mau coba fitur pakai data contoh.
SKIP_SEED=true